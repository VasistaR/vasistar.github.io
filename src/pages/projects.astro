---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../data/projects';
import { withBase, isExternal } from '../utils/url';
---

<BaseLayout
  title="Projects"
  description="Flight software, simulation tooling, and side projects in aerospace and CS."
>
  <div class="wrap">
    <header class="page-header">
      <p class="eyebrow">Projects</p>
      <h1>Things I've built</h1>
      <p class="lede">
        Most of these started as a problem I hit myself and got annoyed enough to fix properly.
        Source is on GitHub where I'm able to share it.
      </p>
    </header>

    <div class="grid">
      {
        PROJECTS.map((p) => (
          <article class="card project">
            <div class="head">
              <h2>{p.title}</h2>
              <span class="year">{p.year}</span>
            </div>

            <p class="blurb">{p.blurb}</p>
            <p class="detail">{p.detail}</p>

            {p.highlight && (
              <p class="stat">
                <strong>{p.highlight.value}</strong>
                <span>{p.highlight.label}</span>
              </p>
            )}

            <ul class="tag-list">
              {p.tags.map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>

            {p.links && p.links.length > 0 && (
              <div class="links">
                {p.links.map((l) => (
                  <a
                    class="arrow-link"
                    href={withBase(l.href)}
                    target={isExternal(l.href) ? '_blank' : undefined}
                    rel={isExternal(l.href) ? 'noopener noreferrer' : undefined}
                  >
                    <span>{l.label}</span>
                    <span>→</span>
                  </a>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.1rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.6rem;
  }

  .project:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-lift);
    transform: translateY(-2px);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .head h2 {
    font-size: 1.14rem;
  }

  .year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .blurb {
    font-size: 0.96rem;
    line-height: 1.6;
  }

  .detail {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .stat {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    border: 1px solid var(--border);
    width: fit-content;
  }

  .stat strong {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--ember);
    line-height: 1;
  }

  .stat span {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  /* Push tags + links to the bottom so cards in a row line up. */
  .project .tag-list {
    margin-top: auto;
    padding-top: 0.3rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
    font-size: 0.87rem;
  }
</style>
