---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
---

<BaseLayout title="Page not found">
  <div class="wrap center">
    <p class="code">404</p>
    <h1>Loss of signal</h1>
    <p class="lede">
      This page isn't on any trajectory I know about. It may have been moved or renamed.
    </p>
    <p class="actions">
      <a class="btn btn-primary" href={withBase('/')}>Back to home</a>
      <a class="btn" href={withBase('/blog')}>Read the blog</a>
    </p>
  </div>
</BaseLayout>

<style>
  .center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(2rem, 10vw, 6rem);
  }

  .code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.25em;
    color: var(--ember);
  }

  h1 {
    font-size: var(--step-3);
    margin-block: 1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 2.2rem;
  }
</style>
