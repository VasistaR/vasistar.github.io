---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AWARDS } from '../data/awards';
---

<BaseLayout
  title="Awards & Honors"
  description="Scholarships, competition results, and academic recognition."
>
  <div class="wrap">
    <header class="page-header">
      <p class="eyebrow">Awards &amp; Honors</p>
      <h1>Recognition</h1>
      <p class="lede">
        Scholarships, competition results, and academic honors from my time at CU Boulder.
      </p>
    </header>

    {
      AWARDS.length === 0 ? (
        <p class="empty">
          Nothing here yet. Add entries to <code>src/data/awards.ts</code>.
        </p>
      ) : (
        <ol class="list">
          {AWARDS.map((award) => (
            <li class="card item">
              <div class="marker" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="9" r="6" />
                  <path d="M8.2 13.8 7 22l5-3 5 3-1.2-8.2" />
                </svg>
              </div>

              <div class="body">
                <p class="meta">
                  <span class="date">{award.date}</span>
                  <span class="kind">{award.kind}</span>
                </p>

                <h2>
                  {award.href ? (
                    <a href={award.href} target="_blank" rel="noopener noreferrer">
                      {award.title}
                    </a>
                  ) : (
                    award.title
                  )}
                </h2>

                <p class="issuer">{award.issuer}</p>
                {award.detail && <p class="detail">{award.detail}</p>}
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</BaseLayout>

<style>
  .empty {
    color: var(--text-muted);
  }

  .empty code {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.13em 0.4em;
  }

  .list {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.2rem;
    padding: 1.5rem;
  }

  .item:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-lift);
  }

  .marker {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .marker svg {
    width: 20px;
    height: 20px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.45rem;
  }

  .date {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.03em;
    color: var(--text-faint);
  }

  .kind {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent-text);
    background: var(--accent-soft);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }

  .body h2 {
    font-size: 1.08rem;
    letter-spacing: -0.015em;
  }

  .body h2 a {
    color: inherit;
    text-decoration: none;
  }

  .body h2 a:hover {
    color: var(--accent-text);
  }

  .issuer {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .detail {
    margin-top: 0.7rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: var(--measure);
  }

  @media (max-width: 34rem) {
    .item {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }
</style>
