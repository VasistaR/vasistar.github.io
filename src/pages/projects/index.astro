---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/url';
import Arrow from '../../components/Arrow.astro';
import { PROJECT_CATEGORIES, ALL_LABEL, categoryLabel } from '../../data/categories';

const projects = (
  await getCollection('projects', ({ data }) => !data.draft || import.meta.env.DEV)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Only offer filters that actually match something, so the menu never shows a
// category that would come back empty.
const counts = new Map<string, number>();
for (const p of projects) {
  for (const c of p.data.categories) counts.set(c, (counts.get(c) ?? 0) + 1);
}
const activeCategories = PROJECT_CATEGORIES.filter((c) => (counts.get(c.id) ?? 0) > 0);
---

<BaseLayout
  title="Projects"
  description="Flight software, simulation tooling, and side projects in aerospace and CS."
>
  <div class="wrap">
    <header class="page-header">
      <p class="eyebrow">Projects</p>
      <h1>Things I've built</h1>
      <p class="lede">
        Most of these started as a problem I hit myself and got annoyed enough to fix properly.
        Each one has a full write-up — click through for the details.
      </p>
    </header>

    {
      activeCategories.length > 0 && (
        <div class="filters" data-filters>
          <div class="chips" role="group" aria-label="Filter projects by category">
            <button class="chip" type="button" data-filter="all" aria-pressed="true">
              {ALL_LABEL}
              <span class="count">{projects.length}</span>
            </button>
            {activeCategories.map((c) => (
              <button class="chip" type="button" data-filter={c.id} aria-pressed="false">
                {c.label}
                <span class="count">{counts.get(c.id)}</span>
              </button>
            ))}
          </div>
          <p class="status" data-status aria-live="polite" />
        </div>
      )
    }

    {
      projects.length === 0 ? (
        <p class="empty">
          No projects yet. Add a <code>.md</code> file to <code>src/content/projects/</code>.
        </p>
      ) : (
        <div class="grid" data-grid>
          {projects.map((p) => (
            <article
              class="card project"
              data-project
              data-categories={p.data.categories.join(' ')}
            >
              <a class="cover-link" href={withBase(`/projects/${p.id}`)} tabindex="-1" aria-hidden="true">
                {p.data.cover ? (
                  <img src={withBase(p.data.cover)} alt="" loading="lazy" />
                ) : (
                  <div class="cover-fallback">
                    <span>{p.data.title.charAt(0)}</span>
                  </div>
                )}
                {p.data.categories.length > 0 && (
                  <ul class="cats">
                    {p.data.categories.map((c) => (
                      <li>{categoryLabel(c)}</li>
                    ))}
                  </ul>
                )}
              </a>

              <div class="body">
                <div class="head">
                  <h2>
                    <a href={withBase(`/projects/${p.id}`)}>{p.data.title}</a>
                  </h2>
                  <span class="year">{p.data.date.getUTCFullYear()}</span>
                </div>

                <p class="blurb">{p.data.description}</p>

                {p.data.highlight && (
                  <p class="stat">
                    <strong>{p.data.highlight.value}</strong>
                    <span>{p.data.highlight.label}</span>
                  </p>
                )}

                <ul class="tag-list">
                  {p.data.tags.map((t) => (
                    <li class="tag">{t}</li>
                  ))}
                </ul>

                <p class="more">
                  <span class="arrow-link">
                    <span>Read the write-up</span>
                    <span><Arrow /></span>
                  </span>
                </p>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

<script>
  // Filtering is a progressive enhancement: the markup ships with every project
  // visible, and the menu only appears once this runs. With JS off you get the
  // full list rather than a row of dead buttons.
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');

  if (bar && grid) {
    const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-project]'));
    const status = bar.querySelector<HTMLElement>('[data-status]');
    const valid = new Set(chips.map((c) => c.dataset.filter));

    function apply(filter: string, updateUrl: boolean) {
      let shown = 0;
      for (const card of cards) {
        const cats = (card.dataset.categories ?? '').split(' ').filter(Boolean);
        const match = filter === 'all' || cats.includes(filter);
        card.hidden = !match;
        if (match) shown++;
      }

      for (const chip of chips) {
        chip.setAttribute('aria-pressed', String(chip.dataset.filter === filter));
      }

      if (status) {
        const label = chips.find((c) => c.dataset.filter === filter)?.textContent?.trim() ?? '';
        status.textContent =
          filter === 'all'
            ? ''
            : `Showing ${shown} ${shown === 1 ? 'project' : 'projects'} in ${label.replace(/\s*\d+$/, '')}.`;
      }

      // Keep the choice in the URL so a filtered view can be linked or reloaded.
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (filter === 'all') url.searchParams.delete('filter');
        else url.searchParams.set('filter', filter);
        history.replaceState(null, '', url);
      }
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => apply(chip.dataset.filter ?? 'all', true));
    }

    // Honour ?filter=… on load, e.g. from a category pill on a project page.
    const initial = new URL(window.location.href).searchParams.get('filter') ?? 'all';
    apply(valid.has(initial) ? initial : 'all', false);

    bar.setAttribute('data-ready', '');
  }
</script>

<style>
  .empty {
    color: var(--text-muted);
  }

  /* ---------- filter menu ---------- */
  .filters {
    display: none;
    margin-bottom: 2rem;
  }

  .filters[data-ready] {
    display: block;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    font-family: inherit;
    font-size: 0.86rem;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.16s var(--ease), border-color 0.16s var(--ease),
      background-color 0.16s var(--ease);
  }

  .chip:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .chip[aria-pressed='true'] {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
  }

  :global(html[data-theme='dark']) .chip[aria-pressed='true'] {
    color: #0a0c10;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    opacity: 0.72;
  }

  .status {
    margin-top: 0.85rem;
    font-size: 0.82rem;
    color: var(--text-faint);
    min-height: 1.2em;
  }

  .empty code {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.13em 0.4em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.1rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .project:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-lift);
    transform: translateY(-2px);
  }

  /* Whole-card affordance: the title link is the real target, this is decorative. */
  .cover-link {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    /* It's an <a>, so the global link underline would strike the fallback letter. */
    text-decoration: none;
  }

  /* Category badges, overlaid on the tile's cover. */
  .cats {
    position: absolute;
    left: 0.7rem;
    bottom: 0.7rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cats li {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text);
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.18rem 0.55rem;
  }

  .cover-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-fallback {
    display: grid;
    place-items: center;
    height: 100%;
    background:
      radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 60%),
      var(--surface-2);
  }

  .cover-fallback span {
    font-family: var(--font-mono);
    font-size: 2.4rem;
    color: var(--text-faint);
    opacity: 0.55;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1.4rem;
    flex: 1;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .head h2 {
    font-size: 1.14rem;
  }

  .head h2 a {
    color: inherit;
    text-decoration: none;
  }

  /* Expand the title link to cover the card so the whole thing is clickable. */
  .head h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project {
    position: relative;
  }

  .head h2 a:hover {
    color: var(--accent-text);
  }

  .year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .blurb {
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .stat {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    border: 1px solid var(--border);
    width: fit-content;
  }

  .stat strong {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--ember);
    line-height: 1;
  }

  .stat span {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .project .tag-list {
    margin-top: auto;
    padding-top: 0.3rem;
  }

  .more {
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
    font-size: 0.87rem;
    color: var(--accent-text);
  }

  .project:hover .arrow-link span:last-child {
    transform: translateX(4px);
  }
</style>
