---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIALS } from '../consts';
import { EXPERIENCE } from '../data/experience';
import { withBase, isExternal } from '../utils/url';
import SocialIcon from '../components/SocialIcon.astro';
import Arrow from '../components/Arrow.astro';

// Falls back to an initials monogram until a headshot path is set in consts.ts.
const initials = SITE.name
  .split(' ')
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();

const featured = (await getCollection('projects', ({ data }) => data.featured && !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const recentRoles = EXPERIENCE.slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// Frontmatter dates like `2026-06-28` parse as UTC midnight. Format in UTC too,
// otherwise anyone west of Greenwich sees every post dated a day early.
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<BaseLayout>
  <div class="wrap">
    <!-- ================= HERO ================= -->
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow status">
          <span class="dot" aria-hidden="true"></span>
          Open to Summer 2027 internships
        </p>

        <h1>
          Hi, I'm {SITE.name.split(' ')[0]}. I build software for things that
          <span class="grad">leave the ground</span>.
        </h1>

        <p class="lede">
          Incoming junior at {SITE.school} studying {SITE.role}. I care about the seam between the
          two — flight software, simulation tooling, and the unglamorous infrastructure that turns
          test data into decisions.
        </p>

        <div class="cta">
          <a class="btn btn-primary" href={withBase(`/projects`)}>See my work</a>
          <a class="btn" href={`mailto:${SITE.email}`}>Get in touch</a>
        </div>

        <ul class="socials">
          {
            SOCIALS.map((s) => (
              <li>
                <a
                  href={withBase(s.href)}
                  target={isExternal(s.href) ? '_blank' : undefined}
                  rel={isExternal(s.href) ? 'noopener noreferrer' : undefined}
                >
                  <SocialIcon name={s.icon} />
                  <span>{s.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!--
        Orbit diagram with the headshot at its centre. The two planets travel
        genuinely separate paths: one along the tilted outer ellipse, one along
        the upright inner circle, in opposite directions.
      -->
      <div class="orbit">
        <svg viewBox="0 0 240 240" role="img" aria-label={`Portrait of ${SITE.name}`}>
          <defs>
            <clipPath id="headshot-clip">
              <circle cx="120" cy="120" r="46"></circle>
            </clipPath>
            <!-- Tilted outer track (matches the drawn ellipse below). -->
            <path
              id="orbit-outer"
              d="M 8,120 A 112,46 0 1,1 232,120 A 112,46 0 1,1 8,120"
              fill="none"></path>
            <!-- Upright inner track (matches the drawn circle below). -->
            <path
              id="orbit-inner"
              d="M 38,120 A 82,82 0 1,1 202,120 A 82,82 0 1,1 38,120"
              fill="none"></path>
          </defs>

          <!-- Rings -->
          <circle class="ring" cx="120" cy="120" r="112" stroke-dasharray="2 7"></circle>
          <circle class="ring" cx="120" cy="120" r="82"></circle>
          <ellipse class="ring" cx="120" cy="120" rx="112" ry="46" transform="rotate(-24 120 120)"
          ></ellipse>

          <!-- Headshot, or initials until one is set -->
          <circle class="hs-bg" cx="120" cy="120" r="46"></circle>
          {
            SITE.headshot ? (
              <image
                href={withBase(SITE.headshot)}
                x="74"
                y="74"
                width="92"
                height="92"
                clip-path="url(#headshot-clip)"
                preserveAspectRatio="xMidYMid slice"
              />
            ) : (
              <text class="hs-initials" x="120" y="120" text-anchor="middle" dy="0.35em">
                {initials}
              </text>
            )
          }
          <circle class="hs-ring" cx="120" cy="120" r="46"></circle>

          <!-- Planet 1 — tilted elliptical orbit -->
          <g transform="rotate(-24 120 120)">
            <circle class="sat" r="5">
              <animateMotion dur="22s" repeatCount="indefinite">
                <mpath href="#orbit-outer" xlink:href="#orbit-outer" />
              </animateMotion>
            </circle>
          </g>

          <!-- Planet 2 — upright circular orbit, opposite direction -->
          <circle class="sat alt" r="3.5">
            <animateMotion
              dur="14s"
              repeatCount="indefinite"
              calcMode="linear"
              keyPoints="1;0"
              keyTimes="0;1"
            >
              <mpath href="#orbit-inner" xlink:href="#orbit-inner" />
            </animateMotion>
          </circle>
        </svg>
      </div>
    </section>

    <!-- ================= FEATURED PROJECTS ================= -->
    <section class="section">
      <h2 class="eyebrow">Selected projects</h2>
      <div class="feature-grid">
        {
          featured.map((p) => (
            <article class="card feature">
              <header>
                <h3>
                  <a href={withBase(`/projects/${p.id}`)}>{p.data.title}</a>
                </h3>
                <span class="year">{p.data.date.getUTCFullYear()}</span>
              </header>
              <p>{p.data.description}</p>
              {p.data.highlight && (
                <p class="stat">
                  <strong>{p.data.highlight.value}</strong> {p.data.highlight.label}
                </p>
              )}
              <ul class="tag-list">
                {p.data.tags.slice(0, 3).map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <a class="arrow-link more" href={withBase(`/projects`)}>
        <span>All projects</span><span><Arrow /></span>
      </a>
    </section>

    <!-- ================= EXPERIENCE SNAPSHOT ================= -->
    <section class="section">
      <h2 class="eyebrow">Where I've worked</h2>
      <ul class="roles">
        {
          recentRoles.map((r) => (
            <li>
              <span class="role-period">{r.period}</span>
              <span class="role-title">{r.role}</span>
              <span class="role-org">{r.org}</span>
            </li>
          ))
        }
      </ul>
      <a class="arrow-link more" href={withBase(`/experience`)}>
        <span>Full experience</span><span><Arrow /></span>
      </a>
    </section>

    <!-- ================= RECENT WRITING ================= -->
    {
      posts.length > 0 && (
        <section class="section">
          <h2 class="eyebrow">Recent writing</h2>
          <ul class="posts">
            {posts.map((post) => (
              <li>
                <a href={withBase(`/blog/${post.id}`)}>
                  <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-desc">{post.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="arrow-link more" href={withBase(`/blog`)}>
            <span>All posts</span>
            <span><Arrow /></span>
          </a>
        </section>
      )
    }
  </div>
</BaseLayout>

<!--
  The global prefers-reduced-motion rule in global.css only reaches CSS
  animations; the orbit uses SMIL <animateMotion>, which has to be paused
  through the DOM instead.
-->
<script is:inline>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelector('.orbit svg')?.pauseAnimations();
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 6vw, 4rem);
  }

  .status {
    color: var(--text-muted);
  }

  .status::after {
    display: none; /* no trailing rule on this one */
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px color-mix(in srgb, #22c55e 20%, transparent);
    animation: pulse 2.4s var(--ease) infinite;
  }

  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 6px color-mix(in srgb, #22c55e 0%, transparent);
    }
  }

  .hero h1 {
    margin-block: 1.4rem 1.5rem;
  }

  .grad {
    background: linear-gradient(100deg, var(--accent) 10%, var(--ember) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    text-decoration: none;
  }

  /* Underline only the label, so the icon isn't clipped by the rule. */
  .socials a span {
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.15s var(--ease);
  }

  .socials a:hover {
    color: var(--accent-text);
  }

  .socials a:hover span {
    border-bottom-color: currentColor;
  }

  .socials :global(.social-icon) {
    font-size: 1.05rem;
  }

  /* ---------- orbit graphic + headshot ---------- */
  .orbit {
    width: clamp(230px, 27vw, 330px);
  }

  .orbit svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ring {
    stroke: var(--border-strong);
    stroke-width: 1;
    fill: none;
  }

  /* Sits behind the portrait so a transparent PNG still reads cleanly. */
  .hs-bg {
    fill: var(--surface-2);
  }

  .hs-ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    opacity: 0.55;
  }

  .hs-initials {
    fill: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 30px;
    letter-spacing: 0.06em;
  }

  .sat {
    fill: var(--ember);
  }

  .sat.alt {
    fill: var(--accent);
  }

  /*
    Mobile hero.

    Goal: everything visible in the desktop first screen — portrait, status,
    heading, lede, buttons and social links — also lands above the fold on a
    phone. That means tightening every vertical measure, not just stacking the
    columns. Sizes here were set by measuring against a 375px-tall-viewport
    phone rather than by eye.
  */
  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 1.1rem;
    }

    /* Portrait leads, but small enough to leave room for the copy. */
    .orbit {
      order: -1;
      width: min(148px, 38vw);
      margin-bottom: 0;
    }

    .hero h1 {
      font-size: clamp(1.6rem, 6.2vw, 2.05rem);
      margin-block: 0.75rem 0.7rem;
    }

    .lede {
      font-size: 0.93rem;
      line-height: 1.5;
      margin-inline: auto;
    }

    .cta {
      margin-top: 1.15rem;
      justify-content: center;
    }

    .cta .btn {
      padding: 0.55rem 1rem;
      font-size: 0.88rem;
    }

    .socials {
      margin-top: 1.1rem;
      gap: 0.85rem;
      justify-content: center;
    }

    .socials a {
      gap: 0.32rem;
      font-size: 0.71rem;
    }

    .socials :global(.social-icon) {
      font-size: 0.95rem;
    }

    .status {
      justify-content: center;
      font-size: 0.66rem;
    }
  }

  /* ---------- featured projects ---------- */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
    gap: 1rem;
    margin-top: 1.6rem;
  }

  .feature {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.4rem;
  }

  .feature:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-lift);
    transform: translateY(-2px);
  }

  .feature header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .feature {
    position: relative;
  }

  .feature h3 {
    font-size: 1.06rem;
  }

  .feature h3 a {
    color: inherit;
    text-decoration: none;
  }

  /* Make the whole card clickable via the title link. */
  .feature h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .feature h3 a:hover {
    color: var(--accent-text);
  }

  .year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .feature p {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .stat {
    font-size: 0.82rem !important;
    color: var(--text-faint) !important;
  }

  .stat strong {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--ember);
    margin-right: 0.35rem;
  }

  .feature .tag-list {
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .more {
    display: inline-flex;
    margin-top: 1.6rem;
    font-size: 0.9rem;
  }

  /* ---------- roles ---------- */
  .roles {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
  }

  .roles li {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }

  .roles li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .role-period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .role-title {
    font-weight: 500;
  }

  .role-org {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  @media (max-width: 40rem) {
    .roles li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  /* ---------- posts ---------- */
  .posts {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
  }

  .posts a {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .posts li:last-child a {
    border-bottom: 1px solid var(--border);
  }

  .posts time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    padding-top: 0.2rem;
  }

  .post-title {
    font-weight: 500;
    transition: color 0.15s var(--ease);
  }

  .posts a:hover .post-title {
    color: var(--accent-text);
  }

  .post-desc {
    grid-column: 2;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  @media (max-width: 40rem) {
    .posts a {
      grid-template-columns: 1fr;
    }
    .post-desc {
      grid-column: 1;
    }
  }
</style>
