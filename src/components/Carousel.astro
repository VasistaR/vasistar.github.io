---
/**
 * Image carousel for project pages.
 *
 * Built on CSS scroll-snap rather than a JS slider: the track is a horizontally
 * scrollable list that snaps to each slide. That means it already works by
 * swiping or scrolling with no JavaScript at all — the arrows, dots and counter
 * are enhancements layered on top, and stay hidden until the script runs.
 */
import { withBase } from '../utils/url';

export interface CarouselImage {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: CarouselImage[];
  label?: string;
}

const { images, label = 'Project images' } = Astro.props;
const multiple = images.length > 1;
---

{
  images.length > 0 && (
    <section
      class="carousel"
      data-carousel
      aria-roledescription="carousel"
      aria-label={label}
    >
      <div class="frame">
        <ul class="track" data-track tabindex="0">
          {images.map((img, i) => (
            <li
              class="slide"
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${images.length}`}
            >
              <figure>
                <img src={withBase(img.src)} alt={img.alt} loading={i === 0 ? 'eager' : 'lazy'} />
                {img.caption && <figcaption>{img.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>

        {multiple && (
          <>
            <button class="nav prev" data-prev type="button" aria-label="Previous image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 18 9 12l6-6" />
              </svg>
            </button>
            <button class="nav next" data-next type="button" aria-label="Next image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m9 18 6-6-6-6" />
              </svg>
            </button>
          </>
        )}
      </div>

      {multiple && (
        <div class="bar">
          <div class="dots" data-dots role="tablist" aria-label="Choose image">
            {images.map((img, i) => (
              <button
                class="dot"
                type="button"
                role="tab"
                data-dot={i}
                aria-label={`Image ${i + 1}: ${img.alt}`}
                aria-selected={i === 0 ? 'true' : 'false'}
              />
            ))}
          </div>
          <p class="counter" data-counter aria-live="polite">
            1 / {images.length}
          </p>
        </div>
      )}
    </section>
  )
}

<style>
  .carousel {
    margin-block: 2.4rem 3rem;
  }

  .frame {
    position: relative;
  }

  .track {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    border-radius: var(--radius);
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    min-width: 0;
  }

  .slide figure {
    margin: 0;
  }

  .slide img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .slide figcaption {
    margin-top: 0.7rem;
    font-size: 0.83rem;
    line-height: 1.5;
    color: var(--text-faint);
    text-align: center;
  }

  /* ---------- controls (revealed only once JS runs) ---------- */
  .nav,
  .bar {
    display: none;
  }

  .carousel[data-ready] .nav {
    display: grid;
  }

  .carousel[data-ready] .bar {
    display: flex;
  }

  .nav {
    position: absolute;
    top: 50%;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    transform: translateY(-50%);
    border: 1px solid var(--border);
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(6px);
    color: var(--text);
    cursor: pointer;
    transition: background-color 0.18s var(--ease), border-color 0.18s var(--ease),
      opacity 0.18s var(--ease);
  }

  .nav svg {
    width: 18px;
    height: 18px;
  }

  .nav:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }

  .nav[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  .nav[disabled]:hover {
    border-color: var(--border);
    color: var(--text);
  }

  .prev {
    left: 0.75rem;
  }

  .next {
    right: 0.75rem;
  }

  .bar {
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  .dots {
    display: flex;
    gap: 0.45rem;
  }

  .dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--border-strong);
    cursor: pointer;
    transition: background-color 0.18s var(--ease), width 0.18s var(--ease);
  }

  .dot[aria-selected='true'] {
    width: 20px;
    border-radius: 999px;
    background: var(--accent);
  }

  .counter {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--text-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;

    const slides = Array.from(track.children) as HTMLElement[];
    if (slides.length < 2) {
      root.setAttribute('data-ready', '');
      return;
    }

    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const counter = root.querySelector<HTMLElement>('[data-counter]');
    let index = 0;

    function go(to: number) {
      index = Math.max(0, Math.min(slides.length - 1, to));
      slides[index].scrollIntoView({ block: 'nearest', inline: 'center' });
    }

    function sync() {
      dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === index)));
      if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
    }

    // Derive the active slide from scroll position, so swiping and the buttons
    // stay in agreement without fighting each other.
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            index = slides.indexOf(entry.target as HTMLElement);
            sync();
          }
        }
      },
      { root: track, threshold: 0.6 }
    );
    slides.forEach((s) => io.observe(s));

    prev?.addEventListener('click', () => go(index - 1));
    next?.addEventListener('click', () => go(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(index + 1);
      }
    });

    root.setAttribute('data-ready', '');
    sync();
  }

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);
</script>
