---
/**
 * Small inline icons for the social links. Brand marks (GitHub, LinkedIn) are
 * solid; the rest are line icons, which is the usual convention and keeps the
 * two groups from fighting each other visually.
 *
 * `currentColor` throughout, so icons inherit the link colour and its hover
 * transition for free.
 */
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<svg
  class="social-icon"
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === 'github' && (
      <path
        fill="currentColor"
        d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.82 1.1.82 2.22 0 1.6-.02 2.9-.02 3.29 0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"
      />
    )
  }

  {
    name === 'linkedin' && (
      <path
        fill="currentColor"
        d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"
      />
    )
  }

  {
    name === 'email' && (
      <g fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
        <path d="m3.5 7 8.5 5.5L20.5 7" />
      </g>
    )
  }

  {
    name === 'resume' && (
      <g fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M14 2.5H6.5a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V8z" />
        <path d="M13.75 2.5V8.5h5.75" />
        <path d="M8.5 13.5h7M8.5 17h4.5" />
      </g>
    )
  }

  {
    !['github', 'linkedin', 'email', 'resume'].includes(name) && (
      <g fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M10.5 13.5a4 4 0 0 0 5.7 0l2.8-2.8a4 4 0 1 0-5.7-5.7l-1.6 1.6" />
        <path d="M13.5 10.5a4 4 0 0 0-5.7 0l-2.8 2.8a4 4 0 1 0 5.7 5.7l1.6-1.6" />
      </g>
    )
  }
</svg>

<style>
  .social-icon {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }
</style>
