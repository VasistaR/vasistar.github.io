---
import { SITE, NAV_LINKS } from '../consts';
import { withBase } from '../utils/url';
import ThemeToggle from './ThemeToggle.astro';

const home = withBase('/');
const current = Astro.url.pathname.replace(/\/$/, '') || '/';

/** A nav item is "current" for its own page and, for /blog, its posts too. */
function isActive(href: string) {
  const full = withBase(href).replace(/\/$/, '') || '/';
  const root = home.replace(/\/$/, '') || '/';
  if (full === root) return current === root;
  return current === full || current.startsWith(full + '/');
}
---

<header>
  <div class="wrap bar">
    <a class="brand" href={home}>
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="12" cy="12" r="3.2"></circle>
          <ellipse cx="12" cy="12" rx="10.2" ry="4.6" transform="rotate(-28 12 12)"></ellipse>
        </svg>
      </span>
      <span class="brand-name">{SITE.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={withBase(link.href)}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.6) blur(12px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 62px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    color: var(--accent);
  }

  .mark svg {
    width: 100%;
    height: 100%;
    transition: transform 0.5s var(--ease);
  }

  .brand:hover .mark svg {
    transform: rotate(180deg);
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.35rem, 2vw, 1.1rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    position: relative;
    display: block;
    padding: 0.4rem 0.15rem;
    font-size: 0.93rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 500;
  }

  /* Underline grows from the centre on hover, sits full-width when current. */
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.22s var(--ease);
  }

  nav a:hover::after {
    transform: scaleX(0.55);
  }

  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  @media (max-width: 30rem) {
    .brand-name {
      display: none;
    }
    nav a {
      font-size: 0.88rem;
    }
  }
</style>
