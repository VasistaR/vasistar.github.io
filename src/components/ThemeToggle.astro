---
/**
 * Two-state theme control: Light ⇄ Dark.
 *
 * The site's *default* still follows the operating system — that's handled by
 * the inline bootstrap in BaseHead.astro, which reads the OS preference when
 * nothing is stored. This button only comes into play once someone overrides
 * it, at which point the choice is remembered in localStorage.
 *
 * Until that first click there is no stored value, so the site keeps tracking
 * live OS changes.
 */
---

<button id="theme-toggle" type="button" title="Change theme" aria-live="polite">
  <span class="icon" data-icon="light" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
    </svg>
  </span>
  <span class="icon" data-icon="dark" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </span>
  <span class="visually-hidden" id="theme-label">Theme</span>
</button>

<style>
  #theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease);
  }

  #theme-toggle:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  /* Both icons stack in the same grid cell; only the active one shows. */
  .icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: scale(0.6) rotate(-25deg);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .icon svg {
    width: 17px;
    height: 17px;
  }

  /*
    Fallback: show the sun when `data-theme` is missing — JS disabled or
    blocked, or a stale cached stylesheet — so the button is never empty.
    Light is the right fallback because the palette in global.css is light
    until `[data-theme='dark']` is set, so the icon always matches the page.
  */
  .icon[data-icon='light'] {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  /*
    An explicit theme on <html> wins over the OS fallback above. These selectors
    are more specific than the plain `.icon[...]` rules, so ordering is not
    load-bearing.
  */
  :global(html[data-theme='light']) .icon[data-icon='light'],
  :global(html[data-theme='dark']) .icon[data-icon='dark'] {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  :global(html[data-theme='light']) .icon[data-icon='dark'],
  :global(html[data-theme='dark']) .icon[data-icon='light'] {
    opacity: 0;
    transform: scale(0.6) rotate(-25deg);
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var btn = document.getElementById('theme-toggle');
    var label = document.getElementById('theme-label');
    var media = window.matchMedia('(prefers-color-scheme: dark)');

    /** Stored override, or null while we're still following the OS. */
    function stored() {
      var v = localStorage.getItem('theme');
      return v === 'light' || v === 'dark' ? v : null;
    }

    function apply(theme) {
      root.dataset.theme = theme;
      var next = theme === 'dark' ? 'light' : 'dark';
      btn.setAttribute('aria-label', 'Switch to ' + next + ' theme');
      label.textContent = theme === 'dark' ? 'Dark theme' : 'Light theme';
    }

    apply(stored() || (media.matches ? 'dark' : 'light'));

    btn.addEventListener('click', function () {
      var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      apply(next);
    });

    // Keep following the OS until the visitor has made an explicit choice.
    media.addEventListener('change', function () {
      if (!stored()) apply(media.matches ? 'dark' : 'light');
    });
  })();
</script>
